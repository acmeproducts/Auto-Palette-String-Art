}

function renderPaletteEditor(){
  paletteList.innerHTML = "";

  palette.forEach((p, index) => {
    const row = document.createElement("div");
    row.className = "palette-row";

    const color = document.createElement("input");
    color.type = "color";
    color.value = p.color;

    color.onchange = function(){
      palette[index].color = color.value;

      const rgb = hexToRgb(color.value);
      palette[index].kind = classifyKindFromRgb(
        rgb.r,
        rgb.g,
        rgb.b
      );
    };

    const name = document.createElement("input");
    name.type = "text";
    name.value = p.name;

    name.onchange = function(){
      palette[index].name = name.value;
      palette[index].id = uniquePaletteId(
        safeIdFromName(name.value, "C" + index),
        index
      );
    };

    const weight = document.createElement("input");
    weight.type = "number";
    weight.min = "0";
    weight.max = "100";
    weight.step = "1";
    weight.value = p.weight;
    weight.title = "Line Weight";

    weight.onchange = function(){
      palette[index].weight = Math.max(
        0,
        parseFloat(weight.value) || 0
      );
    };

    const alpha = document.createElement("input");
    alpha.type = "number";
    alpha.min = "0.005";
    alpha.max = "0.3";
    alpha.step = "0.005";
    alpha.value = p.alpha;
    alpha.title = "Opacity";

    alpha.onchange = function(){
      palette[index].alpha = Math.max(
        0.005,
        Math.min(
          0.3,
          parseFloat(alpha.value) || 0.05
        )
      );
    };

    const del = document.createElement("button");
    del.className = "delete-btn";
    del.textContent = "×";

    del.onclick = function(){
      deleteColor(index);
    };

    row.appendChild(color);
    row.appendChild(name);
    row.appendChild(weight);
    row.appendChild(alpha);
    row.appendChild(del);

    paletteList.appendChild(row);
  });
}
function addColor(){
  const index = palette.length;

  palette.push({
    id:uniquePaletteId("CUSTOM_" + (index + 1), -1),
    name:"CUSTOM " + (index + 1),
    color:"#888888",
    alpha:0.060,
    weight:10,
    width:0.42,
    kind:"color"
  });

  renderPaletteEditor();
}

function deleteColor(index){
  if(palette.length <= 1){
    alert("At least one thread color is required.");
    return;
  }

  palette.splice(index, 1);
  renderPaletteEditor();
}

function updateBackgroundColor(){
  if(!imgData && !rawImage){
    ctx.fillStyle = backgroundColorInput.value;
    ctx.fillRect(0, 0, CANVAS_W, CANVAS_H);
  }

  if(rawImage && !imgData){
    drawPreview();
  }
}

function classifyKindFromRgb(r, g, b){
  const lum = (r + g + b) / 3;
  const max = Math.max(r, g, b);
  const min = Math.min(r, g, b);
  const chroma = max - min;

  if(lum < 55){
    return "dark";
  }

  if(lum > 215 && chroma < 45){
    return "light";
  }

  return "color";
}

function autoPalette(){
  if(!imgData){
    alert("Set image first, then use AutoPalette.");
    return;
  }

  const buckets = {};
  const step = 5;

  for(let y = 0; y < CANVAS_H; y += step){
    for(let x = 0; x < CANVAS_W; x += step){
      if(!isInsideCanvasShape(x, y)){
        continue;
      }

      const idx = y * CANVAS_W + x;

      const r = imgData.data[idx * 4];
      const g = imgData.data[idx * 4 + 1];
      const b = imgData.data[idx * 4 + 2];

      const lum = (r + g + b) / 3;

      if(lum > 245){
        continue;
      }

      const qr = Math.round(r / 32) * 32;
      const qg = Math.round(g / 32) * 32;
      const qb = Math.round(b / 32) * 32;

      const key = qr + "," + qg + "," + qb;

      if(!buckets[key]){
        buckets[key] = {
          r:0,
          g:0,
          b:0,
          count:0
        };
      }

      buckets[key].r += r;
      buckets[key].g += g;
      buckets[key].b += b;
      buckets[key].count++;
    }
  }

  let colors = Object.values(buckets)
    .filter(c => c.count > 2)
    .map(c => ({
      r:c.r / c.count,
      g:c.g / c.count,
      b:c.b / c.count,
      count:c.count
    }))
    .sort((a, b) => b.count - a.count);

  const selected = [];

  for(const c of colors){
    if(selected.length >= 5){
      break;
    }

    let farEnough = true;

    for(const s of selected){
      const dr = c.r - s.r;
      const dg = c.g - s.g;
      const db = c.b - s.b;

      const dist = Math.sqrt(
        dr * dr +
        dg * dg +
        db * db
      );

      if(dist < 55){
        farEnough = false;
        break;
      }
    }

    if(farEnough){
      selected.push(c);
    }
  }

  if(selected.length < 3){
    alert("AutoPalette could not find enough distinct colors. Try a more colorful image.");
    return;
  }

  const newPalette = [
    {
      id:"K",
      name:"BLACK FOUNDATION",
      color:"#080808",
      alpha:0.115,
      weight:28,
      width:0.42,
      kind:"dark"
    }
  ];

  selected.forEach((c, i) => {
    const hex = rgbToHex(
      c.r,
      c.g,
      c.b
    );

    const kind = classifyKindFromRgb(
      c.r,
      c.g,
      c.b
    );

    newPalette.push({
      id:"AUTO_" + (i + 1),
      name:"AUTO " + (i + 1),
      color:hex,
      alpha:kind === "light" ? 0.035 : 0.070,
      weight:12,
      width:0.42,
      kind:kind
    });
  });

  newPalette.push(
    {
      id:"K2",
      name:"BLACK REFINEMENT",
      color:"#000000",
      alpha:0.075,
      weight:14,
      width:0.38,
      kind:"dark"
    },
    {
      id:"W",
      name:"WHITE HIGHLIGHT",
      color:"#ffffff",
      alpha:0.028,
      weight:4,
      width:0.50,
      kind:"light"
    }
  );

  palette = newPalette;

  renderPaletteEditor();
  setStatus("AutoPalette created from image.");
}

fileInput.addEventListener("change", handleFileSelect);

function handleFileSelect(e){
  const file = e.target.files && e.target.files[0];

  if(!file){
    return;
  }

  if(!file.type || !file.type.startsWith("image/")){
    alert("Please choose an image file.");
    fileInput.value = "";
    return;
  }

  const reader = new FileReader();

  reader.onerror = function(){
    alert("Could not read the selected image.");
    fileInput.value = "";
  };

  reader.onload = function(ev){
    const img = new Image();

    img.onerror = function(){
      alert("The selected file could not be loaded as an image.");
      fileInput.value = "";
    };

    img.onload = function(){
      rawImage = img;

      thumbnail.src = ev.target.result;
      thumbnail.style.display = "block";

      scale = Math.max(
        CANVAS_W / rawImage.width,
        CANVAS_H / rawImage.height
      );

      offsetX = CANVAS_W / 2;
      offsetY = CANVAS_H / 2;

      imgData = null;
      edgeMap = null;
      passInstructions = {};
      instructionBox.value = "";

      drawPreview();

      setStatus("Image loaded. Drag or pinch to frame it, then tap Set Image.");
    };

    img.src = ev.target.result;
  };

  reader.readAsDataURL(file);
}

canvas.addEventListener("pointerdown", e => {
  if(isGenerating){
    return;
  }

  canvas.setPointerCapture(e.pointerId);

  const idx = pointers.findIndex(
    p => p.pointerId === e.pointerId
  );

  if(idx >= 0){
    pointers[idx] = e;
  }else{
    pointers.push(e);
  }
});

canvas.addEventListener("pointermove", e => {
  const idx = pointers.findIndex(
    p => p.pointerId === e.pointerId
  );

  if(idx >= 0){
    pointers[idx] = e;
  }

  if(!rawImage || isGenerating){
    return;
  }

  if(pointers.length === 1){
    offsetX += e.movementX;
    offsetY += e.movementY;

    drawPreview();
  }

  if(pointers.length === 2){
    const dx =
      pointers[0].clientX -
      pointers[1].clientX;

    const dy =
      pointers[0].clientY -
      pointers[1].clientY;

    const dist = Math.sqrt(
      dx * dx +
      dy * dy
    );

    if(!startDistance){
      startDistance = dist;
      startScale = scale;
    }else{
      scale =
        startScale *
        (dist / startDistance);

      scale = Math.max(
        0.1,
        Math.min(scale, 20)
      );

      drawPreview();
    }
  }
});

canvas.addEventListener("pointerup", endPointer);
canvas.addEventListener("pointercancel", endPointer);
canvas.addEventListener("pointerleave", endPointer);

function endPointer(e){
  pointers = pointers.filter(
    p => p.pointerId !== e.pointerId
  );

  if(pointers.length < 2){
    startDistance = 0;
  }
}

function setStatus(text){
  statusBox.textContent = text || "";
}

function drawPreview(){
  ctx.clearRect(0, 0, CANVAS_W, CANVAS_H);

  ctx.fillStyle = backgroundColorInput.value;
  ctx.fillRect(0, 0, CANVAS_W, CANVAS_H);

  if(!rawImage){
    return;
  }

  ctx.save();

  beginCanvasClip(ctx);

  ctx.translate(offsetX, offsetY);
  ctx.scale(scale, scale);

  ctx.drawImage(
    rawImage,
    -rawImage.width / 2,
    -rawImage.height / 2
  );

  ctx.restore();
}

function setImage(){
  if(!rawImage){
    alert("Upload image first");
    return;
  }

  const temp = document.createElement("canvas");

  temp.width = CANVAS_W;
  temp.height = CANVAS_H;

  const t = temp.getContext(
    "2d",
    { willReadFrequently:true }
  );

  t.fillStyle = backgroundColorInput.value;
  t.fillRect(0, 0, CANVAS_W, CANVAS_H);

  t.save();

  beginCanvasClip(t);

  t.translate(offsetX, offsetY);
  t.scale(scale, scale);

  t.drawImage(
    rawImage,
    -rawImage.width / 2,
    -rawImage.height / 2
  );

  t.restore();

  imgData = t.getImageData(
    0,
    0,
    CANVAS_W,
    CANVAS_H
  );

  buildEdgeMap();

  setStatus("Image set. Ready to generate.");

  alert("Image set!");
}
function buildPins(n){
  pins = [];

  if(canvasShape === "circle"){
    const cx = CANVAS_W / 2;
    const cy = CANVAS_H / 2;
    const r = Math.min(CANVAS_W, CANVAS_H) / 2 * 0.95;

    for(let i = 0; i < n; i++){
      const a =
        i / n * Math.PI * 2 -
        Math.PI / 2;

      pins.push({
        x:cx + r * Math.cos(a),
        y:cy + r * Math.sin(a)
      });
    }

    return;
  }

  const margin = 2;
  const w = CANVAS_W - margin * 2;
  const h = CANVAS_H - margin * 2;
  const perimeter = 2 * (w + h);

  for(let i = 0; i < n; i++){
    const d = i / n * perimeter;

    let x;
    let y;

    if(d < w){
      x = margin + d;
      y = margin;
    }else if(d < w + h){
      x = margin + w;
      y = margin + (d - w);
    }else if(d < w + h + w){
      x = margin + w - (d - w - h);
      y = margin + h;
    }else{
      x = margin;
      y = margin + h - (d - w - h - w);
    }

    pins.push({
      x:x,
      y:y
    });
  }
}

function getPixels(p1, p2){
  const arr = [];

  let x0 = Math.round(p1.x);
  let y0 = Math.round(p1.y);

  const x1 = Math.round(p2.x);
  const y1 = Math.round(p2.y);

  const dx = Math.abs(x1 - x0);
  const dy = Math.abs(y1 - y0);

  const sx = x0 < x1 ? 1 : -1;
  const sy = y0 < y1 ? 1 : -1;

  let err = dx - dy;

  while(true){
    if(
      x0 >= 0 &&
      y0 >= 0 &&
      x0 < CANVAS_W &&
      y0 < CANVAS_H
    ){
      if(isInsideCanvasShape(x0, y0)){
        arr.push(
          y0 * CANVAS_W + x0
        );
      }
    }

    if(x0 === x1 && y0 === y1){
      break;
    }

    const e2 = 2 * err;

    if(e2 > -dy){
      err -= dy;
      x0 += sx;
    }

    if(e2 < dx){
      err += dx;
      y0 += sy;
    }
  }

  return arr;
}

function buildCache(){
  const n = pins.length;

  lineCache = Array.from(
    { length:n },
    () => Array(n)
  );

  for(let i = 0; i < n; i++){
    for(let j = 0; j < n; j++){
      if(i === j){
        continue;
      }

      lineCache[i][j] = getPixels(
        pins[i],
        pins[j]
      );
    }
  }
}

function buildEdgeMap(){
  edgeMap = new Float32Array(
    CANVAS_W * CANVAS_H
  );

  for(let y = 1; y < CANVAS_H - 1; y++){
    for(let x = 1; x < CANVAS_W - 1; x++){
      if(!isInsideCanvasShape(x, y)){
        continue;
      }

      const i = y * CANVAS_W + x;

      const l = imgData.data[(i - 1) * 4];
      const r = imgData.data[(i + 1) * 4];
      const u = imgData.data[(i - CANVAS_W) * 4];
      const d = imgData.data[(i + CANVAS_W) * 4];

      const gx = r - l;
      const gy = d - u;

      edgeMap[i] =
        Math.sqrt(gx * gx + gy * gy) / 255;
    }
  }
}

function resetCurrentCanvas(){
  const bg = hexToRgb(backgroundColorInput.value);

  for(let i = 0; i < CANVAS_W * CANVAS_H; i++){
    curR[i] = bg.r;
    curG[i] = bg.g;
    curB[i] = bg.b;
  }
}

function getThreadAlpha(idx, pass){
  const tr = imgData.data[idx * 4];
  const tg = imgData.data[idx * 4 + 1];
  const tb = imgData.data[idx * 4 + 2];

  const brightness = (tr + tg + tb) / 765;
  const edgeBoost = edgeMap ? edgeMap[idx] * 0.025 : 0;

  let a = pass.alpha;

  if(pass.kind === "dark"){
    a *= 0.75 + (1 - brightness) * 0.75;
  }

  if(pass.kind === "light"){
    if(brightness < 0.62){
      return 0;
    }

    a *= (brightness - 0.62) * 1.35;
  }

  if(pass.kind === "color"){
    a *= 0.75 + (1 - brightness) * 0.35;
  }

  return Math.max(
    0.005,
    Math.min(0.18, a + edgeBoost)
  );
}

function blendedPixel(idx, pass, r0, g0, b0){
  const rgb = hexToRgb(pass.color);
  const a = getThreadAlpha(idx, pass);

  return {
    r:r0 * (1 - a) + rgb.r * a,
    g:g0 * (1 - a) + rgb.g * a,
    b:b0 * (1 - a) + rgb.b * a
  };
}

function applyPixel(idx, pass){
  const p = blendedPixel(
    idx,
    pass,
    curR[idx],
    curG[idx],
    curB[idx]
  );

  curR[idx] = p.r;
  curG[idx] = p.g;
  curB[idx] = p.b;
}

function targetWeightedError(r, g, b, tr, tg, tb, pass){
  let er = r - tr;
  let eg = g - tg;
  let eb = b - tb;

  let base =
    er * er +
    eg * eg +
    eb * eb;

  if(pass.kind === "dark"){
    const currentLum =
      (r + g + b) / 3;

    const targetLum =
      (tr + tg + tb) / 3;

    base +=
      (currentLum - targetLum) *
      (currentLum - targetLum) *
      1.2;
  }

  if(pass.kind === "light"){
    const currentLum =
      (r + g + b) / 3;

    const targetLum =
      (tr + tg + tb) / 3;

    if(targetLum > currentLum){
      base *= 1.35;
    }
  }

  return base;
}

function render(){
  const img =
    ctx.createImageData(
      CANVAS_W,
      CANVAS_H
    );

  const bg =
    hexToRgb(backgroundColorInput.value);

  for(let i = 0; i < CANVAS_W * CANVAS_H; i++){
    const x = i % CANVAS_W;
    const y = Math.floor(i / CANVAS_W);

    if(!isInsideCanvasShape(x, y)){
      img.data[i * 4] = bg.r;
      img.data[i * 4 + 1] = bg.g;
      img.data[i * 4 + 2] = bg.b;
      img.data[i * 4 + 3] = 255;
      continue;
    }

    img.data[i * 4] =
      Math.max(
        0,
        Math.min(255, curR[i])
      );

    img.data[i * 4 + 1] =
      Math.max(
        0,
        Math.min(255, curG[i])
      );

    img.data[i * 4 + 2] =
      Math.max(
        0,
        Math.min(255, curB[i])
      );

    img.data[i * 4 + 3] = 255;
  }

  ctx.putImageData(img, 0, 0);
}

function buildWeightMask(){
  const mask =
    new Float32Array(
      CANVAS_W * CANVAS_H
    );

  for(let y = 0; y < CANVAS_H; y++){
    for(let x = 0; x < CANVAS_W; x++){
      const idx = y * CANVAS_W + x;

      if(!isInsideCanvasShape(x, y)){
        mask[idx] = 0;
        continue;
      }

      const nx =
        (x - CANVAS_W / 2) /
        (CANVAS_W * 0.35);

      const ny =
        (y - CANVAS_H * 0.45) /
        (CANVAS_H * 0.45);

      const face =
        Math.exp(
          -(nx * nx + ny * ny) * 2
        );

      let base =
        0.4 + face * 1.6;

      if(
        ny < -0.05 &&
        Math.abs(nx) < 0.2
      ){
        base *= 1.4;
      }

      if(
        ny > 0 &&
        ny < 0.2 &&
        Math.abs(nx) < 0.15
      ){
        base *= 1.3;
      }

      mask[idx] = base;
    }
  }

  return mask;
}

async function runPass(pass, totalLines){
  const pinCount = pins.length;
  let currentPin = 0;

  const weightMask = buildWeightMask();

  const MIN_GAP =
    Math.floor(pinCount * 0.05);

  if(!passInstructions[pass.id]){
    passInstructions[pass.id] = [];
  }

  for(let l = 0; l < totalLines; l++){
    let bestPin = -1;
    let bestScore = -Infinity;

    for(let s = 0; s < SAMPLE_SIZE; s++){
      const i =
        Math.floor(
          Math.random() * pinCount
        );

      if(i === currentPin){
        continue;
      }

      let gap =
        Math.abs(i - currentPin);

      gap =
        Math.min(
          gap,
          pinCount - gap
        );

      if(gap < MIN_GAP){
        continue;
      }

      const pixels =
        lineCache[currentPin][i];

      if(!pixels || !pixels.length){
        continue;
      }

      let score = 0;

      for(const idx of pixels){
        const tr =
          imgData.data[idx * 4];

        const tg =
          imgData.data[idx * 4 + 1];

        const tb =
          imgData.data[idx * 4 + 2];

        const beforeR = curR[idx];
        const beforeG = curG[idx];
        const beforeB = curB[idx];

        const after =
          blendedPixel(
            idx,
            pass,
            beforeR,
            beforeG,
            beforeB
          );

        const oldErr =
          targetWeightedError(
            beforeR,
            beforeG,
            beforeB,
            tr,
            tg,
            tb,
            pass
          );

        const newErr =
          targetWeightedError(
            after.r,
            after.g,
            after.b,
            tr,
            tg,
            tb,
            pass
          );

        let local =
          oldErr - newErr;

        local *= weightMask[idx];

        if(edgeMap){
          local +=
            edgeMap[idx] * 0.45;
        }

        score += local;
      }

      score /= pixels.length;

      if(score > bestScore){
        bestScore = score;
        bestPin = i;
      }
    }

    if(bestPin === -1){
      continue;
    }

    for(const idx of lineCache[currentPin][bestPin]){
      applyPixel(idx, pass);
    }

    passInstructions[pass.id].push(
      currentPin +
      " -> " +
      bestPin
    );

    currentPin = bestPin;

    if(l % RENDER_EVERY === 0){
      render();

      await new Promise(
        r => setTimeout(r, 0)
      );
    }
  }

  render();
}
function buildInstructionText(){
  let text = "";

  for(const pass of palette){
    const list =
      passInstructions[pass.id] || [];

    text +=
      pass.name.toUpperCase() +
      "\n";

    text +=
      list.join("\n");

    text += "\n\n";
  }

  return text.trim();
}

async function start(){
  if(isGenerating){
    return;
  }

  if(!imgData){
    alert("Set image first");
    return;
  }

  if(!palette.length){
    alert("Add at least one color.");
    return;
  }

  isGenerating = true;

  setStatus(
    "Generating AutoPalette string art..."
  );

  passInstructions = {};
  instructionBox.value = "";
  bar.style.width = "0%";

  palette.forEach((p, index) => {
    p.id =
      uniquePaletteId(
        safeIdFromName(p.name, p.id),
        index
      );

    if(!p.width){
      p.width = 0.42;
    }

    if(!p.kind){
      const rgb =
        hexToRgb(p.color);

      p.kind =
        classifyKindFromRgb(
          rgb.r,
          rgb.g,
          rgb.b
        );
    }
  });

  const pinCount =
    parseInt(
      pinsInput.value,
      10
    );

  const totalLines =
    parseInt(
      linesInput.value,
      10
    );

  buildPins(pinCount);

  setStatus(
    "Building line cache..."
  );

  await new Promise(
    r => setTimeout(r, 0)
  );

  buildCache();

  resetCurrentCanvas();

  const totalWeight =
    palette.reduce(
      (sum, p) =>
        sum +
        Math.max(
          0,
          Number(p.weight) || 0
        ),
      0
    ) || 1;

  let usedLines = 0;

  for(let i = 0; i < palette.length; i++){
    const pass = palette[i];

    let passLines;

    if(i === palette.length - 1){
      passLines =
        Math.max(
          0,
          totalLines - usedLines
        );
    }else{
      passLines =
        Math.floor(
          totalLines *
          (
            Math.max(
              0,
              Number(pass.weight) || 0
            ) /
            totalWeight
          )
        );

      usedLines += passLines;
    }

    setStatus(
      "Running " +
      pass.name +
      " pass..."
    );

    await runPass(
      pass,
      passLines
    );

    const progress =
      Math.round(
        ((i + 1) / palette.length) *
        100
      );

    bar.style.width =
      progress + "%";
  }

  instructionBox.value =
    buildInstructionText();

  setStatus("Done.");

  isGenerating = false;
}

function copyInstructions(){
  const text = instructionBox.value;

  if(!text){
    alert("No instructions to copy yet.");
    return;
  }

  if(navigator.clipboard && window.isSecureContext){
    navigator.clipboard
      .writeText(text)
      .then(() => alert("Copied"));
  }else{
    const temp =
      document.createElement("textarea");

    temp.value = text;

    document.body.appendChild(temp);

    temp.select();

    document.execCommand("copy");

    document.body.removeChild(temp);

    alert("Copied");
  }
}

function downloadFile(filename, content, mime){
  const blob =
    new Blob(
      [content],
      { type:mime }
    );

  const url =
    URL.createObjectURL(blob);

  const a =
    document.createElement("a");

  a.href = url;
  a.download = filename;

  document.body.appendChild(a);

  a.click();

  document.body.removeChild(a);

  URL.revokeObjectURL(url);
}

function downloadTXT(){
  const text =
    instructionBox.value;

  if(!text){
    alert("No instructions to export yet.");
    return;
  }

  downloadFile(
    "AutoPalette_string_art_instructions.txt",
    text,
    "text/plain"
  );
}

function parseInstructionLine(line){
  const parts =
    line
      .split("->")
      .map(
        v => parseInt(
          v.trim(),
          10
        )
      );

  if(
    parts.length !== 2 ||
    isNaN(parts[0]) ||
    isNaN(parts[1])
  ){
    return null;
  }

  return parts;
}

function svgLineForInstruction(line, color, opacity, width){
  const pair =
    parseInstructionLine(line);

  if(!pair){
    return "";
  }

  const p1 = pins[pair[0]];
  const p2 = pins[pair[1]];

  if(!p1 || !p2){
    return "";
  }

  return `<line x1="${p1.x.toFixed(2)}" y1="${p1.y.toFixed(2)}" x2="${p2.x.toFixed(2)}" y2="${p2.y.toFixed(2)}" stroke="${color}" stroke-width="${width}" stroke-opacity="${opacity}" stroke-linecap="round" />\n`;
}

function downloadSVG(){
  if(!pins.length){
    alert("Generate string art first.");
    return;
  }

  const bg =
    backgroundColorInput.value;

  let svg = "";

  svg +=
    `<svg xmlns="http://www.w3.org/2000/svg" width="${CANVAS_W}" height="${CANVAS_H}" viewBox="0 0 ${CANVAS_W} ${CANVAS_H}">\n`;

  svg +=
    `<rect width="100%" height="100%" fill="${bg}"/>\n`;

  svg += `<defs>\n`;

  svg += `<clipPath id="shapeClip">\n`;

  if(canvasShape === "circle"){
    svg +=
      `<circle cx="${CANVAS_W / 2}" cy="${CANVAS_H / 2}" r="${RADIUS * 0.95}"/>\n`;
  }else{
    svg +=
      `<rect x="0" y="0" width="${CANVAS_W}" height="${CANVAS_H}"/>\n`;
  }

  svg += `</clipPath>\n`;

  svg += `</defs>\n`;

  for(const pass of palette){
    const groupName =
      safeIdFromName(
        pass.name,
        pass.id
      ) +
      "_LINES";

    const list =
      passInstructions[pass.id] || [];

    svg +=
      `<g id="${groupName}" clip-path="url(#shapeClip)" fill="none" stroke-linecap="round">\n`;

    for(const line of list){
      svg +=
        svgLineForInstruction(
          line,
          pass.color,
          pass.alpha,
          pass.width || 0.42
        );
    }

    svg += `</g>\n`;
  }

  svg += `</svg>`;

  downloadFile(
    "AutoPalette_actual_visible_thread_lines_" +
    canvasShape +
    "_" +
    CANVAS_W +
    "x" +
    CANVAS_H +
    ".svg",
    svg,
    "image/svg+xml"
  );
}

function resetAll(){
  rawImage = null;
  imgData = null;
  edgeMap = null;

  offsetX = CANVAS_W / 2;
  offsetY = CANVAS_H / 2;
  scale = 1;

  pointers = [];
  startDistance = 0;
  startScale = 1;

  pins = [];
  lineCache = [];

  curR =
    new Float32Array(
      CANVAS_W * CANVAS_H
    );

  curG =
    new Float32Array(
      CANVAS_W * CANVAS_H
    );

  curB =
    new Float32Array(
      CANVAS_W * CANVAS_H
    );

  passInstructions = {};
  isGenerating = false;

  instructionBox.value = "";

  thumbnail.style.display = "none";
  thumbnail.src = "";

  fileInput.value = "";

  bar.style.width = "0%";

  ctx.clearRect(
    0,
    0,
    CANVAS_W,
    CANVAS_H
  );

  ctx.fillStyle =
    backgroundColorInput.value;

  ctx.fillRect(
    0,
    0,
    CANVAS_W,
    CANVAS_H
  );

  setStatus("");

  updatePinSpacingBox();
}

restoreDefaultPalette();
applyCanvasShape();
updateBackgroundColor();
updatePinSpacingBox();

</script>

