    },
    {
      id:"Y",
      name:"YELLOW",
      color:"#f5d223",
      alpha:0.070,
      weight:13,
      width:0.42,
      kind:"color"
    },
    {
      id:"R",
      name:"RED",
      color:"#dc2320",
      alpha:0.070,
      weight:13,
      width:0.42,
      kind:"color"
    },
    {
      id:"G",
      name:"GREEN",
      color:"#1c9646",
      alpha:0.065,
      weight:13,
      width:0.42,
      kind:"color"
    },
    {
      id:"B",
