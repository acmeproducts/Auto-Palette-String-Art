</head>

<body>

<div class="controls">
  <h3>AutoPalette String Art Generator</h3>

  <div class="icon-row">
    <label for="fileInput" class="icon-btn">📷</label>
    <button type="button" class="icon-btn" onclick="copyInstructions()">📋</button>
  </div>

  <input type="file" id="fileInput" accept="image/*">

  <div class="input-row">
    Pins
    <input type="number" id="pins" value="400" min="50" max="1200">

    Lines
    <input type="number" id="lines" value="12000" min="100" max="40000">
  </div>

  <div class="input-row">
    Canvas Shape
    <select id="canvasShape" onchange="applyCanvasShape()">
      <option value="circle">Circle</option>
      <option value="square">Square</option>
      <option value="rectangle">Rectangle</option>
    </select>

    Width
    <input type="number" id="canvasWidthInput" value="480" min="100" max="1200">

    Height
    <input type="number" id="canvasHeightInput" value="720" min="100" max="1200">

    <button class="std" onclick="applyCanvasShape()">Apply Canvas</button>
  </div>

  <div id="pinSpacingBox">
    Pin spacing info will appear here.
  </div>

  <div class="input-row">
    Background Canvas Color
    <input type="color" id="backgroundColor" value="#ffffff" onchange="updateBackgroundColor()">
  </div>

  <button class="std" onclick="setImage()">Set Image</button>
  <button class="std" onclick="start()">Generate</button>
  <button class="std" onclick="resetAll()">Reset</button>
  <button class="std" onclick="downloadTXT()">Export TXT</button>
  <button class="std" onclick="downloadSVG()">Export SVG</button>

  <br>

  <img id="thumbnail" alt="thumbnail">

  <div id="progress">
    <div id="bar"></div>
  </div>

  <div id="status"></div>
</div>

<div class="palette-panel">
  <div class="palette-title">Thread Palette</div>

  <div id="paletteList"></div>

  <button class="std" onclick="addColor()">Add Color</button>
  <button class="std" onclick="autoPalette()">AutoPalette From Image</button>
  <button class="std" onclick="restoreDefaultPalette()">Restore Default KYRGB + K2 + White</button>

  <div class="small-note">
    Each color has a line-weight and opacity. Weight controls how many lines the pass receives.
    Opacity controls how strongly each string affects the render and SVG.
  </div>
</div>

<div class="wrapper" id="canvasWrapper">
  <canvas id="canvas"></canvas>
</div>

<h3>Pin-to-Pin Instructions</h3>

<textarea id="instructions" readonly></textarea>

<script>
let CANVAS_W = 480;
let CANVAS_H = 720;
let RADIUS = 240;
let canvasShape = "circle";

const SAMPLE_SIZE = 70;
const RENDER_EVERY = 80;

let rawImage = null;
let imgData = null;
let edgeMap = null;

let offsetX = CANVAS_W / 2;
let offsetY = CANVAS_H / 2;
let scale = 1;

let pointers = [];
let startDistance = 0;
let startScale = 1;

let pins = [];
let lineCache = [];

let curR = new Float32Array(CANVAS_W * CANVAS_H);
let curG = new Float32Array(CANVAS_W * CANVAS_H);
let curB = new Float32Array(CANVAS_W * CANVAS_H);

let passInstructions = {};
let isGenerating = false;

let palette = [];

const canvas = document.getElementById("canvas");
const ctx = canvas.getContext("2d", { willReadFrequently:true });

const canvasWrapper = document.getElementById("canvasWrapper");

const bar = document.getElementById("bar");
const statusBox = document.getElementById("status");
const instructionBox = document.getElementById("instructions");
const thumbnail = document.getElementById("thumbnail");

const fileInput = document.getElementById("fileInput");
const pinsInput = document.getElementById("pins");
const linesInput = document.getElementById("lines");

const canvasShapeInput = document.getElementById("canvasShape");
const canvasWidthInput = document.getElementById("canvasWidthInput");
const canvasHeightInput = document.getElementById("canvasHeightInput");

const paletteList = document.getElementById("paletteList");
const backgroundColorInput = document.getElementById("backgroundColor");
const pinSpacingBox = document.getElementById("pinSpacingBox");

canvas.width = CANVAS_W;
canvas.height = CANVAS_H;
canvas.style.borderRadius = "50%";
canvasWrapper.style.aspectRatio = CANVAS_W + " / " + CANVAS_H;

pinsInput.addEventListener("input", updatePinSpacingBox);
canvasWidthInput.addEventListener("input", updatePinSpacingBox);
canvasHeightInput.addEventListener("input", updatePinSpacingBox);
canvasShapeInput.addEventListener("change", updatePinSpacingBox);
function hexToRgb(hex){
  let h = String(hex || "#000000").replace("#", "").trim();

  if(h.length === 3){
    h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
  }

  const n = parseInt(h, 16);

  return {
    r:(n >> 16) & 255,
    g:(n >> 8) & 255,
    b:n & 255
  };
}

function rgbToHex(r, g, b){
  return "#" + [r, g, b].map(v => {
    const h = Math.max(0, Math.min(255, Math.round(v))).toString(16);
    return h.length === 1 ? "0" + h : h;
  }).join("");
}

function safeIdFromName(name, fallback){
  let s = String(name || fallback || "COLOR")
    .toUpperCase()
    .replace(/[^A-Z0-9]+/g, "_");

  s = s.replace(/^_+|_+$/g, "");

  return s || fallback || "COLOR";
}

function uniquePaletteId(base, ownIndex){
  let id = safeIdFromName(base, "COLOR");
  let candidate = id;
  let n = 2;

  while(palette.some((p, i) => i !== ownIndex && p.id === candidate)){
    candidate = id + "_" + n;
    n++;
  }

  return candidate;
}

function updatePinSpacingBox(){
  const totalPins = parseInt(pinsInput.value, 10) || 0;

  if(!pinSpacingBox){
    return;
  }

  if(canvasShapeInput.value !== "rectangle"){
    pinSpacingBox.innerHTML =
      "<b>Pin Spacing:</b><br>" +
      "Select Rectangle canvas to see top/bottom and left/right pin spacing.";
    return;
  }

  let w = parseInt(canvasWidthInput.value, 10);
  let h = parseInt(canvasHeightInput.value, 10);

  if(isNaN(w) || w < 100){
    w = CANVAS_W;
  }

  if(isNaN(h) || h < 100){
    h = CANVAS_H;
  }

  if(totalPins <= 0){
    pinSpacingBox.innerHTML =
      "<b>Rectangle Pin Spacing</b><br>" +
      "Enter a valid total pin count.";
    return;
  }

  const perimeter = 2 * (w + h);
  const spacing = perimeter / totalPins;

  const topPinsExact = w / spacing;
  const bottomPinsExact = topPinsExact;
  const leftPinsExact = h / spacing;
  const rightPinsExact = leftPinsExact;

  const topPins = Math.round(topPinsExact);
  const bottomPins = Math.round(bottomPinsExact);
  const leftPins = Math.round(leftPinsExact);
  const rightPins = Math.round(rightPinsExact);

  const roundedTotal =
    topPins +
    bottomPins +
    leftPins +
    rightPins;

  pinSpacingBox.innerHTML =
    "<b>Rectangle Pin Spacing</b><br>" +
    "Canvas: " + w + " × " + h + " units<br>" +
    "Total Pins: " + totalPins + "<br>" +
    "Perimeter: " + perimeter.toFixed(2) + " units<br>" +
    "Approx. spacing: " + spacing.toFixed(2) + " units between pins<br><br>" +

    "<b>Approximate Pins Per Side</b><br>" +
    "Top: " + topPins + " pins<br>" +
    "Bottom: " + bottomPins + " pins<br>" +
    "Left: " + leftPins + " pins<br>" +
    "Right: " + rightPins + " pins<br>" +
    "Rounded side total: " + roundedTotal + " pins<br><br>" +

    "<b>Exact Side Ratios</b><br>" +
    "Top exact: " + topPinsExact.toFixed(2) + "<br>" +
    "Bottom exact: " + bottomPinsExact.toFixed(2) + "<br>" +
    "Left exact: " + leftPinsExact.toFixed(2) + "<br>" +
    "Right exact: " + rightPinsExact.toFixed(2) + "<br><br>" +

    "Pins are placed evenly around the full perimeter. Longer sides receive more pins automatically.";
}

function applyCanvasShape(){
  canvasShape = canvasShapeInput.value;

  let w = parseInt(canvasWidthInput.value, 10);
  let h = parseInt(canvasHeightInput.value, 10);

  if(isNaN(w) || w < 100){
    w = 280;
  }

  if(isNaN(h) || h < 100){
    h = 280;
  }

  if(w > 1200){
    w = 1200;
  }

  if(h > 1200){
    h = 1200;
  }

  if(canvasShape === "circle"){
    const s = Math.min(w, h);
    w = s;
    h = s;
  }

  if(canvasShape === "square"){
    const s = Math.min(w, h);
    w = s;
    h = s;
  }

  CANVAS_W = w;
  CANVAS_H = h;
  RADIUS = Math.min(CANVAS_W, CANVAS_H) / 2;

  canvasWidthInput.value = CANVAS_W;
  canvasHeightInput.value = CANVAS_H;

  canvas.width = CANVAS_W;
  canvas.height = CANVAS_H;

  canvasWrapper.style.aspectRatio = CANVAS_W + " / " + CANVAS_H;

  if(canvasShape === "circle"){
    canvas.style.borderRadius = "50%";
  }else{
    canvas.style.borderRadius = "0";
  }

  offsetX = CANVAS_W / 2;
  offsetY = CANVAS_H / 2;

  curR = new Float32Array(CANVAS_W * CANVAS_H);
  curG = new Float32Array(CANVAS_W * CANVAS_H);
  curB = new Float32Array(CANVAS_W * CANVAS_H);

  imgData = null;
  edgeMap = null;

  pins = [];
  lineCache = [];
  passInstructions = {};

  instructionBox.value = "";
  bar.style.width = "0%";

  ctx.clearRect(0, 0, CANVAS_W, CANVAS_H);
  ctx.fillStyle = backgroundColorInput.value;
  ctx.fillRect(0, 0, CANVAS_W, CANVAS_H);

  if(rawImage){
    scale = Math.max(
      CANVAS_W / rawImage.width,
      CANVAS_H / rawImage.height
    );

    drawPreview();
  }

  setStatus(
    "Canvas changed to " +
    canvasShape +
    " " +
    CANVAS_W +
    " × " +
    CANVAS_H +
    "."
  );

  updatePinSpacingBox();
}

function isInsideCanvasShape(x, y){
  if(canvasShape === "circle"){
    const dx = x - CANVAS_W / 2;
    const dy = y - CANVAS_H / 2;

    return dx * dx + dy * dy <= RADIUS * RADIUS;
  }

  return (
    x >= 0 &&
    y >= 0 &&
    x < CANVAS_W &&
    y < CANVAS_H
  );
}

function beginCanvasClip(context){
  context.beginPath();

  if(canvasShape === "circle"){
    context.arc(
      CANVAS_W / 2,
      CANVAS_H / 2,
      RADIUS,
      0,
      Math.PI * 2
    );
  }else{
    context.rect(
      0,
      0,
      CANVAS_W,
      CANVAS_H
    );
  }

  context.clip();
}

function restoreDefaultPalette(){
  palette = [
    {
      id:"K",
      name:"BLACK FOUNDATION",
      color:"#080808",
      alpha:0.115,
      weight:28,
      width:0.42,
